<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Autohand.CodeAgentSdk\Autohand.CodeAgentSdk.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\ExampleSupport.cs" Link="ExampleSupport.cs" />
  </ItemGroup>
</Project>
